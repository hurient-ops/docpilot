<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:type="TaskPaneApp">
  <Id>b7a8d5f3-524c-4183-b789-9a2cfb2d1891</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>DocPilot AI</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="DocPilot AI Assistant" />
  <Description DefaultValue="MS Office 문서 내부에서 DocPilot AI 기능을 즉시 호출하는 플러그인입니다." />
  
  <Hosts>
    <Host Name="Document" /> <!-- Word -->
    <Host Name="Presentation" /> <!-- PowerPoint -->
    <Host Name="Workbook" /> <!-- Excel -->
  </Hosts>
  
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
